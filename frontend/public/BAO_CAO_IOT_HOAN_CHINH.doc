<div class="Section1">
  <div style="text-align:center;border:2pt double #1e3a8a;padding:24pt 16pt;margin-bottom:24pt;">
    <p style="font-size:14pt;font-weight:bold;margin:4pt 0;">HỌC VIỆN CÔNG NGHỆ BƯU CHÍNH VIỄN THÔNG</p>
    <p style="font-size:13pt;font-weight:bold;margin:4pt 0 24pt;">KHOA CÔNG NGHỆ THÔNG TIN 1</p>
